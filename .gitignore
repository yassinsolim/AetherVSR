node_modules/
dist/
.DS_Store
*.local
.vite/

# Training corpus: fetched by tools/fetch-corpus.py, never committed.
# The manifest that records provenance and licences IS committed.
data/corpus/*
!data/corpus/manifest.json

# The natural-image evaluation crops ARE committed. They are 3.4 MB of CC0
# images, and a benchmark whose inputs 404 on a clean checkout is not
# reproducible - independent review pointed out that the published numbers
# could not be re-derived by anyone but us.

# Python bytecode. tools/ is a build/analysis toolchain, not a package.
__pycache__/
*.py[cod]

# Seed sweep weights: regenerate with tools/run-seeds.sh. The aggregated
# results in results/ are committed; 5+ model files per configuration are not.
# Root-anchored: an unanchored `models/` also swallowed public/models, which
# holds the shipped weights.
/models/

# Generated and refetchable image corpora. Both are large and both have a
# deterministic producer with pinned hashes, so committing them buys nothing a
# clone cannot rebuild - and costs every clone ~400 MB.
#
#   data/video/       227 MB, procedurally generated from seed 424242 by
#                     tools/videobench.py --prepare
#   data/eval-independent/  170 MB, refetched by tools/fetch-independent-eval.py
#                     against the URLs and SHA-256 in its manifest
#
# The manifests and scores stay tracked: they are what pin the content.
data/video/**
!data/video/manifest.json
!data/video/baseline_scores.json
data/eval-independent/*
!data/eval-independent/manifest.json

# Captured-footage corpus: fetched from pinned URLs, never redistributed.
# tools/fetch-captured.py rebuilds it; the manifest pins URL + SHA-256.
data/captured/sources/
data/captured/clips/
# Looped captured clips for the live browser runtime test; regenerated on demand.
public/media/captured/
data/captured/gopdiag/

# Captured training video: fetched from pinned URLs, never redistributed.
data/captured-train/sources/
data/captured-train/clips/
